# Application environment mode: 'dev' | 'test' | 'prod'
# - dev: Auto-verified citizen for rapid frontend development
# - test: Unverified citizen to test ID verification prompts and unlock flow
# - prod: Strict mode (requires real authentication & verification)
VITE_APP_ENV=dev

# Backend API URL
VITE_API_URL=http://localhost:8000

# Cloudflare Turnstile Site Key (Cloudflare always-passing test key)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Supabase Credentials (optional for local mock testing)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
